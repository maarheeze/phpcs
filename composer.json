{
    "name": "maarheeze/phpcs",
    "description": "phpcs-extension with a custom ruleset",
    "keywords": ["dev"],
    "type": "phpcodesniffer-standard",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Maarheeze\\": "src/Maarheeze"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maarheeze\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "slevomat/coding-standard": "^8.0",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    }
}
