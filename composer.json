{
    "name": "maarheeze/phpcs",
    "description": "phpcs-extension with a custom ruleset",
    "keywords": ["dev"],
    "type": "phpcodesniffer-standard",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "maarheeze\\phpcs\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "slevomat/coding-standard": "^8.0",
        "squizlabs/php_codesniffer": "^3.6.0"
    }
}
